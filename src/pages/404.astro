---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Seite nicht gefunden | tryoud" description="Diese Seite existiert nicht.">
  <main class="min-h-screen flex flex-col items-center justify-center text-center px-6">
    <p class="eyebrow mb-5">404</p>
    <h1 class="h-section mb-6">Seite nicht gefunden.</h1>
    <p class="text-ink-2 text-lg max-w-md mb-10">Die Seite, die du suchst, existiert nicht (mehr). Zurück zur Startseite:</p>
    <a href="/" class="btn btn-primary text-base">
      Zur Startseite
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
    </a>
  </main>
</Layout>
