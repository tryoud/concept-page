---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css'

interface Props {
  title: string;
  description?: string;
  lang?: string;
  ogImage?: string;
  canonical?: string;
}

const {
  title,
  description = 'tryoud — maßgeschneiderte Websites für mittelständische Unternehmen, von Hand entwickelt statt Baukasten. Dazu Foto, Video und Drohnenaufnahmen aus einer Hand.',
  lang = 'de',
  ogImage = '/og/og-tryoud.png',
  canonical,
} = Astro.props;

const siteUrl = 'https://tryoud.com';

/* Starting prices, mirrored from Services.astro. Structured data must match the
   prices a visitor actually sees, so these three places move together. */
const offers = [
  { price: '1490', de: 'Websites & Landing Pages', en: 'Websites & Landing Pages' },
  { price: '850', de: 'Foto & Video', en: 'Photo & Video' },
  { price: '590', de: 'Drohne & Aerial', en: 'Drone & Aerial' },
];
const fullCanonical = canonical ? `${siteUrl}${canonical}` : `${siteUrl}${Astro.url.pathname}`;
const fullOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
---

<!doctype html>
<html lang={lang} class="dark" data-reduced-motion="false">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#050506" />

		<!-- Set before first paint so scroll-reveal only hides content when JS can bring it back -->
		<script is:inline>document.documentElement.classList.add('js');</script>

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<!-- Loaded async: a blocking Google Fonts request would hold up first paint -->
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap"
			media="print"
			onload="this.media='all'"
		/>
		<noscript>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap" />
		</noscript>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Canonical -->
    <link rel="canonical" href={fullCanonical} />
    
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={fullCanonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />
    
    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      name: "Nikolas Maerker",
      url: siteUrl,
      jobTitle: "Web Developer & Creative",
      sameAs: [
        "https://www.instagram.com/nikolasmaerker",
        "https://github.com/tryoud",
        "https://www.linkedin.com/in/nikolasmaerker/"
      ]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      name: "tryoud",
      url: siteUrl,
      image: fullOgImage,
      description: "Webdesign, Webentwicklung und Content-Produktion (Foto, Video, Drohne) für mittelständische Unternehmen.",
      founder: { "@type": "Person", name: "Nikolas Maerker" },
      areaServed: "DE",
      email: "nikolas.maerker@gmail.com",
      priceRange: "€€",
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: lang === 'en' ? "Services" : "Leistungen",
        itemListElement: offers.map(offer => ({
          "@type": "Offer",
          priceCurrency: "EUR",
          price: offer.price,
          priceSpecification: {
            "@type": "PriceSpecification",
            priceCurrency: "EUR",
            price: offer.price,
            valueAddedTaxIncluded: false
          },
          itemOffered: { "@type": "Service", name: lang === 'en' ? offer.en : offer.de }
        }))
      }
    })} />
    
    <ClientRouter />
	</head>
	<body class="bg-[#050506] text-zinc-100 antialiased overflow-x-hidden selection:bg-cyan-500/30 selection:text-cyan-200">

		<slot />

		<script>
      document.addEventListener('astro:page-load', () => {
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        document.documentElement.setAttribute('data-reduced-motion', String(prefersReducedMotion));
      });
		</script>
	</body>
</html>

<style is:global>
  /* Reduced motion: disable animations globally */
  html[data-reduced-motion="true"] *,
  html[data-reduced-motion="true"] *::before,
  html[data-reduced-motion="true"] *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
</style>