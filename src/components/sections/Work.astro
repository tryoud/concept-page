---
interface Props {
  lang?: string;
}
const { lang = 'de' } = Astro.props;
const isEn = lang === 'en';

const projects = [
  {
    key: 'tum',
    name: 'TUM Management Alumni',
    href: 'https://tum-management-alumni.de/',
    tags: ['WordPress', 'Relaunch'],
    tagsEn: ['WordPress', 'Relaunch'],
    de: 'Relaunch der Alumni-Plattform der TUM School of Management — neue Informationsarchitektur und ein zeitgemäßer Auftritt.',
    en: 'Relaunch of the TUM School of Management alumni platform — new information architecture and a contemporary look.',
    img: 'https://s0.wordpress.com/mshots/v1/https%3A%2F%2Ftum-management-alumni.de%2F?w=1400&h=900',
    alt: 'TUM Management Alumni Screenshot',
    wide: true,
  },
  {
    key: 'focuspartner',
    name: 'Focus Partner',
    href: 'https://focuspartner.app/',
    tags: ['Astro', 'Produktseite'],
    tagsEn: ['Astro', 'Product page'],
    de: 'Konzept, Design und Entwicklung einer Produktseite — statisch mit Astro gebaut und weltweit per CDN ausgeliefert.',
    en: 'Concept, design, and development of a product page — statically built with Astro, delivered worldwide via CDN.',
    img: 'https://s0.wordpress.com/mshots/v1/https%3A%2F%2Ffocuspartner.app%2F?w=1400&h=900',
    alt: 'Focus Partner Screenshot',
    wide: false,
  },
  {
    key: 'examdraft',
    name: 'ExamDraft',
    href: 'https://examdraft.com/',
    tags: ['Astro', 'SaaS'],
    tagsEn: ['Astro', 'SaaS'],
    de: 'Landingpage für eine KI-Lernplattform — vom ersten Entwurf bis zum Launch, auf Anmeldungen optimiert.',
    en: 'Landing page for an AI learning platform — from first draft to launch, optimized for sign-ups.',
    img: 'https://s0.wordpress.com/mshots/v1/https%3A%2F%2Fexamdraft.com%2F?w=1400&h=900',
    alt: 'ExamDraft Screenshot',
    wide: false,
  },
  {
    key: 'cantero',
    name: 'Cantero Consulting',
    href: 'https://www.cantero-consulting.de/',
    tags: ['Astro', 'Beratung'],
    tagsEn: ['Astro', 'Consulting'],
    de: 'Beratungswebsite mit klarer Conversion-Führung — Positionierung, Text und Umsetzung aus einer Hand.',
    en: 'Consulting website with clear conversion guidance — positioning, copy, and build from one source.',
    img: 'https://s0.wordpress.com/mshots/v1/https%3A%2F%2Fwww.cantero-consulting.de%2F?w=1400&h=900',
    alt: 'Cantero Consulting Screenshot',
    wide: false,
  },
  {
    key: 'wiro',
    name: 'WIRO e.V.',
    href: 'https://www.wiro-alumni.de/',
    tags: ['WordPress', 'Relaunch'],
    tagsEn: ['WordPress', 'Relaunch'],
    de: 'Relaunch des Alumni-Netzwerks — klare Struktur, moderner Auftritt und einfache Pflege für den Verein.',
    en: 'Relaunch of the alumni network — clear structure, modern look, and easy maintenance for the association.',
    img: 'https://s0.wordpress.com/mshots/v1/https%3A%2F%2Fwww.wiro-alumni.de%2F?w=1400&h=900',
    alt: 'WIRO Alumni Screenshot',
    wide: false,
  },
];
---

<section id="work" class="section w-full bg-[#0b0c0e] relative z-40 border-t border-white/10">
  <div class="shell">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12 reveal-on-scroll">
      <div class="max-w-xl">
        <span class="eyebrow mb-3" data-i18n="work.eyebrow">{isEn ? 'Selected work' : 'Referenzen'}</span>
        <h2 class="text-3xl md:text-5xl text-white leading-[1.1]" data-i18n="work.heading">
          {isEn ? 'Live and in use.' : 'Live und im Einsatz.'}
        </h2>
      </div>
      <p class="text-zinc-400 max-w-sm leading-relaxed" data-i18n="work.subline">
        {isEn ? 'Every site below is online right now — click through and judge for yourself.' : 'Jede Seite hier unten ist gerade online — klick dich durch und urteile selbst.'}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {projects.map((p, i) => (
        <a
          href={p.href}
          target="_blank"
          rel="noopener"
          class={`group relative block overflow-hidden rounded-2xl border border-white/10 bg-[#0f1114] transition-all duration-500 hover:border-cyan-500/40 reveal-on-scroll ${p.wide ? 'md:col-span-2' : ''}`}
          style={`--reveal-delay: ${Math.min(i, 3) * 70}ms`}
        >
          <div class={`relative overflow-hidden bg-[#15181d] ${p.wide ? 'aspect-[16/10] md:aspect-[21/9]' : 'aspect-[16/10]'}`}>
            <img
              src={p.img}
              alt={p.alt}
              class="w-full h-full object-cover object-top opacity-85 transition-all duration-700 ease-out group-hover:opacity-100 group-hover:scale-[1.02]"
              loading="lazy"
              decoding="async"
            />

            <!-- Solid under the caption, clear over the screenshot: a flat 55% scrim
                 across the whole card washed the shots out into empty boxes, while a
                 soft one let the site's own headline bleed through the caption.
                 Only from md up, where the caption actually sits on the image. -->
            <div
              class="hidden md:block absolute inset-0 pointer-events-none"
              style="background: linear-gradient(to top, #08090b 0%, #08090b 26%, rgba(8,9,11,0.78) 44%, rgba(8,9,11,0.15) 70%, rgba(8,9,11,0) 100%);"
            ></div>
          </div>

          <!-- Below the image on phones: overlaid, the caption was taller than the
               card and spilled over the screenshot. -->
          <div class="relative bg-[#0f1114] p-6 md:bg-transparent md:absolute md:bottom-0 md:left-0 md:right-0 md:p-7">
            <div class="flex flex-wrap gap-1.5 mb-3">
              {(isEn ? p.tagsEn : p.tags).map(t => (
                <span class="px-2.5 py-1 text-[0.7rem] font-medium rounded-md bg-white/8 border border-white/10 text-zinc-300 backdrop-blur-sm">{t}</span>
              ))}
            </div>
            <div class="flex items-end justify-between gap-4">
              <div>
                <h3 class={`font-semibold text-white mb-1.5 ${p.wide ? 'text-2xl md:text-3xl' : 'text-xl md:text-2xl'}`}>{p.name}</h3>
                <p class="text-zinc-400 text-sm max-w-xl leading-relaxed" data-i18n={`work.items.${p.key}`}>{isEn ? p.en : p.de}</p>
              </div>
              <span class="shrink-0 hidden sm:flex w-10 h-10 items-center justify-center rounded-full border border-white/20 text-white transition-all duration-300 group-hover:bg-white group-hover:text-black group-hover:border-white" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
