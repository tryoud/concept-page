---
interface Props {
  lang?: string;
}
const { lang = 'de' } = Astro.props;
const isEn = lang === 'en';

const projects = [
  {
    key: 'focuspartner',
    name: 'Focus Partner',
    href: 'https://focuspartner.app/',
    tag: 'Astro · Product',
    accent: 'cyan',
    de: 'Konzept, Design und Entwicklung einer Produktseite — statisch mit Astro gebaut und weltweit per CDN ausgeliefert.',
    en: 'Concept, design, and development of a product page — statically built with Astro, delivered worldwide via CDN.',
    img: 'https://s0.wordpress.com/mshots/v1/https%3A%2F%2Ffocuspartner.app%2F?w=1400&h=900',
    alt: 'Focus Partner Screenshot',
    wide: true,
  },
  {
    key: 'examdraft',
    name: 'ExamDraft',
    href: 'https://examdraft.com/',
    tag: 'Astro · SaaS',
    accent: 'violet',
    de: 'Landingpage für eine KI-Lernplattform — vom ersten Entwurf bis zum Launch, auf Anmeldungen optimiert.',
    en: 'Landing page for an AI learning platform — from first draft to launch, optimized for sign-ups.',
    img: 'https://s0.wordpress.com/mshots/v1/https%3A%2F%2Fexamdraft.com%2F?w=1400&h=900',
    alt: 'ExamDraft Screenshot',
    wide: false,
  },
  {
    key: 'tum',
    name: 'TUM Management Alumni',
    href: 'https://tum-management-alumni.de/',
    tag: 'WordPress · PHP',
    accent: 'cyan',
    de: 'Relaunch der Alumni-Plattform der TUM School of Management — neue Informationsarchitektur und ein zeitgemäßer Auftritt.',
    en: 'Relaunch of the TUM School of Management alumni platform — new information architecture and a contemporary look.',
    img: 'https://s0.wordpress.com/mshots/v1/https%3A%2F%2Ftum-management-alumni.de%2F?w=1400&h=900',
    alt: 'TUM Management Alumni Screenshot',
    wide: false,
  },
  {
    key: 'cantero',
    name: 'Cantero Consulting',
    href: 'https://www.cantero-consulting.de/',
    tag: 'Astro · Figma',
    accent: 'amber',
    de: 'Beratungswebsite mit klarer Conversion-Führung — Positionierung, Text und Umsetzung aus einer Hand.',
    en: 'Consulting website with clear conversion guidance — positioning, copy, and build from one source.',
    img: 'https://s0.wordpress.com/mshots/v1/https%3A%2F%2Fwww.cantero-consulting.de%2F?w=1400&h=900',
    alt: 'Cantero Consulting Screenshot',
    wide: false,
  },
  {
    key: 'wiro',
    name: 'WIRO e.V.',
    href: 'https://www.wiro-alumni.de/',
    tag: 'WordPress · PHP',
    accent: 'violet',
    de: 'Relaunch des Alumni-Netzwerks — klare Struktur, moderner Auftritt und einfache Pflege für den Verein.',
    en: 'Relaunch of the alumni network — clear structure, modern look, and easy maintenance for the association.',
    img: 'https://s0.wordpress.com/mshots/v1/https%3A%2F%2Fwww.wiro-alumni.de%2F?w=1400&h=900',
    alt: 'WIRO Alumni Screenshot',
    wide: false,
  },
];

const accentChip = {
  cyan: 'bg-cyan-500/15 text-cyan-300 border-cyan-500/30',
  violet: 'bg-violet-500/15 text-violet-300 border-violet-500/30',
  amber: 'bg-amber-500/15 text-amber-300 border-amber-500/30',
};
const accentBorder = {
  cyan: 'hover:border-cyan-500/50',
  violet: 'hover:border-violet-500/50',
  amber: 'hover:border-amber-500/50',
};
---

<!-- Tech Stack -->
<section class="py-24 px-6 md:px-16 lg:px-24 border-y border-white/5 bg-black relative overflow-hidden flex justify-center">
  <div class="w-full max-w-6xl flex flex-col md:flex-row items-center gap-16 justify-between relative z-10">
    <div class="flex-1 w-full max-w-2xl reveal-on-scroll">
      <h2 class="text-2xl md:text-4xl font-bold text-white mb-6" data-i18n="stack.heading">{isEn ? 'Tools & Technologies' : 'Tools & Technologien'}</h2>
      <p class="text-zinc-400 text-lg mb-8 max-w-lg" data-i18n="stack.subline">
        {isEn ? 'A modern stack for high-performance results. Fast implementation, clean structure.' : 'Moderner Stack für performante Ergebnisse. Schnelle Umsetzung, saubere Struktur.'}
      </p>
      <div class="flex flex-wrap gap-3">
        {["Astro", "WordPress", "Figma", "TypeScript", "Cloudflare", "Premiere Pro", "Lightroom"].map(tag => (
          <span class="px-4 py-2 rounded-lg bg-white/5 border border-white/10 text-sm text-zinc-300 font-medium hover:bg-white/10 hover:text-white transition-colors">{tag}</span>
        ))}
      </div>
    </div>
    <div class="hidden md:flex flex-1 w-full justify-center items-center reveal-on-scroll">
      <div class="relative w-64 h-64">
        <div class="absolute inset-0 rounded-3xl bg-gradient-to-tr from-cyan-500/20 to-violet-500/20 border border-white/10"></div>
        <div class="absolute inset-6 rounded-2xl bg-[#0a0a0b] border border-white/10 flex items-center justify-center text-white">
          <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Project Showcase -->
<section class="py-24 md:py-32 px-6 md:px-16 lg:px-24 w-full bg-[#030303] relative" id="work">
  <div class="max-w-7xl mx-auto">
    <div class="mb-12 md:mb-16 reveal-on-scroll">
      <span class="text-xs tracking-[0.3em] text-cyan-500 uppercase font-bold mb-4 block">{isEn ? 'References' : 'Referenzen'}</span>
      <h2 class="text-4xl md:text-6xl font-black text-white tracking-tight uppercase" data-i18n="work.heading">{isEn ? 'Selected Work' : 'Ausgewählte Arbeiten'}</h2>
      <div class="h-1 w-24 bg-cyan-500 mt-4 rounded-full"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6">
      {projects.map(p => (
        <a
          href={p.href}
          target="_blank"
          rel="noopener"
          class={`group relative block overflow-hidden rounded-3xl border border-white/10 bg-[#0a0a0a] transition-colors duration-500 reveal-on-scroll ${accentBorder[p.accent]} ${p.wide ? 'md:col-span-2' : ''}`}
        >
          <div class={`overflow-hidden ${p.wide ? 'aspect-[16/10] md:aspect-[21/9]' : 'aspect-[16/10]'}`}>
            <img
              src={p.img}
              alt={p.alt}
              class="w-full h-full object-cover object-top opacity-80 transition-transform duration-700 ease-out group-hover:scale-[1.03]"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/25 to-transparent pointer-events-none"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6 md:p-8">
            <span class={`px-3 py-1 text-xs font-semibold rounded-full border mb-3 inline-block ${accentChip[p.accent]}`}>{p.tag}</span>
            <div class="flex items-end justify-between gap-4">
              <div>
                <h3 class={`font-black text-white mb-1 ${p.wide ? 'text-3xl md:text-5xl' : 'text-2xl md:text-3xl'}`}>{p.name}</h3>
                <p class="text-zinc-400 text-sm md:text-base max-w-xl" data-i18n={`work.items.${p.key}`}>{isEn ? p.en : p.de}</p>
              </div>
              <span class="shrink-0 hidden sm:inline-flex items-center gap-2 px-4 py-2 rounded-full border border-white/20 text-xs text-white uppercase font-bold tracking-widest transition-all duration-300 group-hover:bg-white group-hover:text-black" data-i18n="work.visit">{isEn ? 'Visit →' : 'Besuchen →'}</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
