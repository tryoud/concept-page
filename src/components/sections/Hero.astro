---
interface Props {
  lang?: string;
}
const { lang = 'de' } = Astro.props;
const isEn = lang === 'en';

const chips = [
  { key: 'hero.chip1', de: 'Von Hand entwickelt', en: 'Hand-coded' },
  { key: 'hero.chip2', de: 'Eigener Foto- & Videocontent', en: 'Own photo & video content' },
  { key: 'hero.chip3', de: 'Ein Ansprechpartner', en: 'One point of contact' },
];

const clients = ['TUM Management Alumni', 'Cantero Consulting', 'ExamDraft', 'WIRO e.V.', 'Focus Partner'];

/* The showcase stack. Order matters: last entry renders on top / closest to the viewer.
   Screenshots come from the same mshots service the Work section uses. */
const showcase = [
  { name: 'Focus Partner', domain: 'focuspartner.app', url: 'https%3A%2F%2Ffocuspartner.app%2F' },
  { name: 'ExamDraft', domain: 'examdraft.com', url: 'https%3A%2F%2Fexamdraft.com%2F' },
  { name: 'Cantero Consulting', domain: 'cantero-consulting.de', url: 'https%3A%2F%2Fwww.cantero-consulting.de%2F' },
  { name: 'TUM Management Alumni', domain: 'tum-management-alumni.de', url: 'https%3A%2F%2Ftum-management-alumni.de%2F' },
];
---

<!-- Hero backdrop. Pure CSS so the fold paints instantly with no third-party request. -->
<div class="fixed inset-0 -z-20 hero-backdrop" aria-hidden="true">
  <div class="hero-grid"></div>
  <div class="hero-glow"></div>
</div>

<section class="relative min-h-[100dvh] w-full flex flex-col justify-center pt-28 pb-28 md:pt-32 md:pb-24 overflow-hidden">
  <div class="shell">
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.95fr)] gap-12 lg:gap-8 items-center">
      <!-- Copy -->
      <div class="max-w-2xl">
        <div class="reveal-on-scroll inline-flex items-center gap-2.5 rounded-full border border-white/15 bg-white/5 backdrop-blur-sm px-3.5 py-1.5 mb-7">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-cyan-400 opacity-60"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-cyan-400"></span>
          </span>
          <span class="text-xs font-medium text-white/80" data-i18n="hero.badge">{isEn ? 'Taking on new projects' : 'Kapazität für neue Projekte'}</span>
        </div>

        <h1 class="text-[2.25rem] sm:text-5xl md:text-6xl lg:text-[3.75rem] font-bold tracking-tight text-white leading-[1.06] reveal-on-scroll" style="--reveal-delay: 60ms">
          <span class="block" data-i18n="hero.line1">{isEn ? 'Custom-built websites' : 'Websites nach Maß'}</span>
          <span class="block" data-i18n="hero.line2">{isEn ? 'for companies' : 'für Unternehmen,'}</span>
          <span class="block"><span data-i18n="hero.line3Prefix">{isEn ? 'that want more' : 'die mehr wollen'}</span> <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-300 via-cyan-400 to-blue-500 bg-[length:200%_auto] animate-gradient" data-i18n="hero.line3Accent">{isEn ? 'than standard.' : 'als Standard.'}</span></span>
        </h1>

        <p class="mt-6 text-base sm:text-lg text-zinc-300/90 max-w-xl leading-relaxed reveal-on-scroll" style="--reveal-delay: 120ms" data-i18n="hero.subline">
          {isEn ? 'Individually designed, hand-coded — and filled with your own photo, video, and drone content instead of stock material.' : 'Individuell konzipiert, von Hand entwickelt — und mit eigenem Foto-, Video- und Drohnencontent gefüllt statt mit Stockmaterial.'}
        </p>

        <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2.5 reveal-on-scroll" style="--reveal-delay: 160ms">
          {chips.map(c => (
            <li class="flex items-center gap-2 text-sm text-zinc-300">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-cyan-400 shrink-0"><path d="M20 6 9 17l-5-5"/></svg>
              <span data-i18n={c.key}>{isEn ? c.en : c.de}</span>
            </li>
          ))}
        </ul>

        <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4 mt-9 reveal-on-scroll" style="--reveal-delay: 200ms">
          <a href="#contact" class="group btn btn-primary text-base w-full sm:w-auto">
            <span data-i18n="hero.primaryCta">{isEn ? 'Start a project' : 'Projekt anfragen'}</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
          </a>
          <a href="#work" class="btn btn-secondary text-base w-full sm:w-auto">
            <span data-i18n="hero.secondaryCta">{isEn ? 'View work' : 'Arbeiten ansehen'}</span>
          </a>
        </div>

        <p class="mt-4 text-sm text-zinc-500 reveal-on-scroll" style="--reveal-delay: 240ms" data-i18n="hero.microTrust">
          {isEn ? 'Free, non-binding assessment — usually within 24 hours.' : 'Kostenlose, unverbindliche Einschätzung — in der Regel innerhalb von 24 Stunden.'}
        </p>
      </div>

      <!-- Showcase: real client sites, angled and drifting -->
      <div class="showcase reveal-on-scroll hidden lg:block" style="--reveal-delay: 280ms" aria-hidden="true">
        <div class="showcase-stage">
          {showcase.map((s, i) => (
            <figure class={`showcase-card showcase-card-${i}`}>
              <div class="showcase-chrome">
                <span class="showcase-dot"></span>
                <span class="showcase-dot"></span>
                <span class="showcase-dot"></span>
                <span class="showcase-url">{s.domain}</span>
              </div>
              <img
                src={`https://s0.wordpress.com/mshots/v1/${s.url}?w=1000&h=680`}
                alt=""
                width="1000"
                height="680"
                loading={i >= showcase.length - 2 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </figure>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Trust bar pinned to the bottom of the fold -->
  <div class="absolute inset-x-0 bottom-0 border-t border-white/10 bg-black/25 backdrop-blur-sm">
    <div class="shell py-4 md:py-5">
      <div class="flex flex-col md:flex-row md:items-center gap-3 md:gap-8">
        <p class="text-[0.65rem] uppercase tracking-[0.2em] text-zinc-500 shrink-0" data-i18n="hero.trust">{isEn ? 'Trusted by' : 'Vertrauen von'}</p>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-1.5 text-zinc-400 text-sm font-medium">
          {clients.map((c, i) => (
            <>
              {i > 0 && <span class="hidden sm:inline text-zinc-700" aria-hidden="true">·</span>}
              <span>{c}</span>
            </>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-backdrop {
    background:
      radial-gradient(ellipse 80% 55% at 12% -10%, rgba(34, 211, 238, 0.13), transparent 62%),
      radial-gradient(ellipse 65% 50% at 92% 8%, rgba(59, 130, 246, 0.10), transparent 60%),
      #050506;
  }
  /* Faint engineering grid — reads as "built, not assembled" without competing with the copy */
  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.028) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.028) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 75% 60% at 30% 25%, #000 20%, transparent 75%);
  }
  /* Bottom fade so the hero dissolves into the first section instead of ending on a hard edge */
  .hero-glow {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, rgba(5, 5, 6, 0.85) 88%, #050506 100%);
  }

  /* ---------- Showcase stack ---------- */

  .showcase {
    perspective: 1800px;
    perspective-origin: 50% 50%;
  }
  .showcase-stage {
    position: relative;
    height: 28rem;
    transform-style: preserve-3d;
    /* Rotate the whole stack once, so each card only carries its own offset */
    transform: rotateY(-20deg) rotateX(6deg) rotateZ(2deg);
  }

  .showcase-card {
    position: absolute;
    width: 27rem;
    border-radius: 0.75rem;
    overflow: hidden;
    background: #15181d;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow:
      0 2px 8px rgba(0, 0, 0, 0.4),
      0 24px 60px -12px rgba(0, 0, 0, 0.75);
    animation: showcase-drift 14s ease-in-out infinite;
  }
  .showcase-card img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    object-position: top center;
    /* mshots renders on white; knock it back so bright shots don't blow out the dark hero */
    filter: saturate(0.92) brightness(0.92);
  }

  .showcase-chrome {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 0.75rem;
    background: #1c2027;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }
  .showcase-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.16);
  }
  .showcase-url {
    margin-left: 0.5rem;
    font-size: 0.6875rem;
    color: rgba(255, 255, 255, 0.4);
    letter-spacing: 0.01em;
  }

  /* Depth is carried by translateZ so the perspective does the scaling for us.
     Every card stays at left >= 0 so the stack never reaches into the copy column. */
  .showcase-card-0 { top: 0;       left: 8rem; transform: translateZ(-190px); opacity: 0.45; animation-delay: 0s; }
  .showcase-card-1 { top: 3.75rem; left: 6rem; transform: translateZ(-110px); opacity: 0.62; animation-delay: 1.2s; }
  .showcase-card-2 { top: 7.5rem;  left: 3rem; transform: translateZ(-30px);  opacity: 0.82; animation-delay: 2.4s; }
  .showcase-card-3 { top: 11.25rem; left: 0;   transform: translateZ(50px);   opacity: 1;    animation-delay: 3.6s; }

  @keyframes showcase-drift {
    0%, 100% { translate: 0 0; }
    50%      { translate: 0 -14px; }
  }

  @media (min-width: 1024px) and (max-width: 1400px) {
    .showcase-stage { height: 24rem; }
    .showcase-card { width: 23rem; }
    .showcase-card-0 { top: 0; left: 6rem; }
    .showcase-card-1 { top: 3.25rem; left: 4.5rem; }
    .showcase-card-2 { top: 6.5rem; left: 2.25rem; }
    .showcase-card-3 { top: 9.75rem; left: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .showcase-card { animation: none; }
  }
</style>
