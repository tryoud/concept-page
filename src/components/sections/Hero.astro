---
interface Props {
  lang?: string;
}
const { lang = 'de' } = Astro.props;
const isEn = lang === 'en';

const chips = [
  { key: 'hero.chip1', de: 'Von Hand entwickelt', en: 'Hand-coded' },
  { key: 'hero.chip2', de: 'Eigener Foto- & Videocontent', en: 'Own photo & video content' },
  { key: 'hero.chip3', de: 'Ein Ansprechpartner', en: 'One point of contact' },
];

const clients = ['TUM Management Alumni', 'Cantero Consulting', 'ExamDraft', 'WIRO e.V.', 'Focus Partner'];

/* Two real client sites below the fold copy. Screenshots come from the same
   mshots service the Work section uses. */
const showcase = [
  { name: 'TUM Management Alumni', domain: 'tum-management-alumni.de', url: 'https%3A%2F%2Ftum-management-alumni.de%2F' },
  { name: 'Focus Partner', domain: 'focuspartner.app', url: 'https%3A%2F%2Ffocuspartner.app%2F' },
];
---

<section class="relative w-full pt-32 pb-16 md:pt-44 md:pb-20">
  <div class="shell">
    <p class="reveal-on-scroll flex items-center gap-2.5 text-sm text-ink-2 mb-8 md:mb-10">
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-accent" aria-hidden="true"></span>
      <span data-i18n="hero.badge">{isEn ? 'Taking on new projects' : 'Kapazität für neue Projekte'}</span>
    </p>

    <h1 class="h-display max-w-5xl reveal-on-scroll" style="--reveal-delay: 60ms">
      <span data-i18n="hero.line1">{isEn ? 'Custom-built websites' : 'Websites nach Maß'}</span>
      <span data-i18n="hero.line2">{isEn ? 'for companies' : 'für Unternehmen,'}</span>
      <span data-i18n="hero.line3Prefix">{isEn ? 'that want more' : 'die mehr wollen'}</span>
      <span class="em" data-i18n="hero.line3Accent">{isEn ? 'than standard.' : 'als Standard.'}</span>
    </h1>

    <div class="mt-10 md:mt-14 grid grid-cols-1 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] gap-10 lg:gap-16 lg:items-end">
      <div class="reveal-on-scroll" style="--reveal-delay: 120ms">
        <p class="text-lg md:text-xl text-ink-2 max-w-xl leading-relaxed" data-i18n="hero.subline">
          {isEn ? 'Individually designed, hand-coded - and filled with your own photo, video, and drone content instead of stock material.' : 'Individuell konzipiert, von Hand entwickelt - und mit eigenem Foto-, Video- und Drohnencontent gefüllt statt mit Stockmaterial.'}
        </p>

        <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4 mt-8">
          <a href="#contact" class="btn btn-primary text-base w-full sm:w-auto">
            <span data-i18n="hero.primaryCta">{isEn ? 'Start a project' : 'Projekt anfragen'}</span>
          </a>
          <a href="#work" class="btn btn-secondary text-base w-full sm:w-auto">
            <span data-i18n="hero.secondaryCta">{isEn ? 'View work' : 'Arbeiten ansehen'}</span>
          </a>
        </div>
        <p class="mt-4 text-sm text-ink-3" data-i18n="hero.microTrust">
          {isEn ? 'Free, non-binding assessment - usually within 24 hours.' : 'Kostenlose, unverbindliche Einschätzung - in der Regel innerhalb von 24 Stunden.'}
        </p>
      </div>

      <ul class="reveal-on-scroll border-t rule lg:justify-self-end w-full lg:max-w-sm" style="--reveal-delay: 160ms">
        {chips.map((c, i) => (
          <li class="flex items-baseline gap-4 py-3 border-b rule text-sm">
            <span class="text-ink-3 tabular-nums w-5 shrink-0">{i + 1}</span>
            <span class="text-ink" data-i18n={c.key}>{isEn ? c.en : c.de}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Two real sites, no tilt, no float: the work speaks for itself -->
    <div class="mt-14 md:mt-20 grid grid-cols-1 md:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)] gap-4 md:gap-5 reveal-on-scroll" style="--reveal-delay: 200ms" aria-hidden="true">
      {showcase.map((s, i) => (
        <figure class={`frame ${i === 1 ? 'hidden md:block' : ''}`}>
          <div class="frame-bar">
            <span class="frame-dot"></span>
            <span class="frame-dot"></span>
            <span class="frame-dot"></span>
            <span class="frame-url">{s.domain}</span>
          </div>
          <div class={i === 0 ? 'aspect-[16/10] md:aspect-[16/9]' : 'aspect-[16/9]'}>
            <img
              src={`https://s0.wordpress.com/mshots/v1/${s.url}?w=1400&h=900`}
              alt=""
              width="1400"
              height="900"
              loading="eager"
              fetchpriority={i === 0 ? 'high' : 'low'}
              decoding="async"
            />
          </div>
        </figure>
      ))}
    </div>

    <div class="mt-8 md:mt-10 flex flex-col md:flex-row md:items-baseline gap-2 md:gap-8 text-sm reveal-on-scroll">
      <p class="text-ink-3 shrink-0" data-i18n="hero.trust">{isEn ? 'Trusted by' : 'Vertrauen von'}</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-1.5 text-ink-2">
        {clients.map(c => <li>{c}</li>)}
      </ul>
    </div>
  </div>
</section>
