---
interface Props {
  lang?: string;
}
const { lang = 'de' } = Astro.props;
const isEn = lang === 'en';
---

<!-- The one dark block on the page: closes the story and makes the form unmissable -->
<section id="contact" class="section on-ink w-full bg-ink text-paper">
  <div class="shell">
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1fr)] gap-12 lg:gap-24 items-start">
      <div class="reveal-on-scroll flex flex-col items-start text-left lg:sticky lg:top-28">
        <span class="eyebrow mb-5 !text-paper/55" data-i18n="contact.eyebrow">{isEn ? 'Contact' : 'Kontakt'}</span>
        <h2 class="h-section mb-6">
          <span data-i18n="contact.headingPrefix">{isEn ? "Let's build something" : 'Lass uns etwas'}</span>
          <span class="em" data-i18n="contact.headingAccent">{isEn ? 'lasting' : 'Bleibendes'}</span>
          <span data-i18n="contact.headingSuffix">{isEn ? 'together.' : 'bauen.'}</span>
        </h2>
        <p class="text-lg text-paper/70 mb-3 max-w-md leading-relaxed" data-i18n="contact.subline">
          {isEn ? "Tell me briefly about your project - you'll usually get an honest assessment within 24 hours." : 'Erzähl mir kurz von deinem Projekt - du bekommst in der Regel innerhalb von 24 Stunden eine ehrliche Einschätzung.'}
        </p>
        <p class="text-sm text-paper/50 max-w-md" data-i18n="contact.reassurance">
          {isEn ? 'Free and non-binding - no newsletters, no hold music.' : 'Unverbindlich und kostenlos - keine Newsletter, keine Warteschleife.'}
        </p>

        <dl class="mt-10 pt-6 border-t border-paper/15 w-full max-w-md grid grid-cols-1 sm:grid-cols-[auto_1fr] gap-x-8 gap-y-1 sm:gap-y-3 text-sm">
          <dt class="text-paper/50" data-i18n="contact.directLabel">{isEn ? 'Or email me directly:' : 'Oder direkt per E-Mail:'}</dt>
          <dd><a href="mailto:nikolas.maerker@gmail.com" class="link text-paper break-all">nikolas.maerker@gmail.com</a></dd>
          <dt class="text-paper/50 mt-3 sm:mt-0">Social</dt>
          <dd class="flex flex-wrap gap-x-5 gap-y-1">
            <a href="https://www.instagram.com/nikolasmaerker" target="_blank" rel="noopener" class="link text-paper">Instagram</a>
            <a href="https://www.linkedin.com/in/nikolasmaerker/" target="_blank" rel="noopener" class="link text-paper">LinkedIn</a>
            <a href="https://github.com/tryoud" target="_blank" rel="noopener" class="link text-paper">GitHub</a>
          </dd>
        </dl>
      </div>

      <form id="contact-form" class="reveal-on-scroll w-full flex flex-col gap-5 lg:pt-2" action="https://formspree.io/f/mzdakanj" method="POST">
        <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" style="position:absolute;left:-9999px;">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 sm:gap-8">
          <input type="text" name="name" placeholder={isEn ? 'Name' : 'Name'} data-i18n-placeholder="contact.form.name" required class="field">
          <input type="email" name="email" placeholder={isEn ? 'Email' : 'E-Mail'} data-i18n-placeholder="contact.form.email" required class="field">
        </div>
        <select id="contact-service" name="service" class="field">
          <option value="" data-i18n="contact.form.serviceDefault">{isEn ? 'What do you need?' : 'Was brauchst du?'}</option>
          <option value="web" data-i18n="services.web.title">{isEn ? 'Websites & Landing Pages' : 'Websites & Landing Pages'}</option>
          <option value="content" data-i18n="services.content.title">{isEn ? 'Photo & Video' : 'Foto & Video'}</option>
          <option value="drone" data-i18n="services.drone.title">{isEn ? 'Drone & Aerial' : 'Drohne & Aerial'}</option>
          <option value="other" data-i18n="contact.form.serviceOther">{isEn ? 'Something else' : 'Etwas anderes'}</option>
        </select>
        <input type="text" name="subject" placeholder={isEn ? 'Subject' : 'Betreff'} data-i18n-placeholder="contact.form.subject" class="field">
        <textarea name="message" rows="4" placeholder={isEn ? 'Message' : 'Nachricht'} data-i18n-placeholder="contact.form.message" required class="field resize-none"></textarea>
        <div class="pt-3">
          <button type="submit" id="contact-submit" class="btn btn-primary w-full sm:w-fit text-base disabled:opacity-60">
            <span data-i18n="contact.form.submit">{isEn ? 'Send message' : 'Nachricht senden'}</span>
          </button>
        </div>
        <p id="contact-status" class="hidden text-sm border-l-2 pl-4 py-1" role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    // AJAX form submit: keep the visitor on the page and confirm inline
    const form = document.getElementById('contact-form');
    const submitBtn = document.getElementById('contact-submit');
    const statusEl = document.getElementById('contact-status');
    if (form && submitBtn && statusEl && !form.dataset.ajaxBound) {
      form.dataset.ajaxBound = 'true';
      const getStrings = () => {
        const lang = document.documentElement.lang === 'en' ? 'en' : 'de';
        const dict = window.__SITE_DATA__?.[lang]?.contact?.form ?? {};
        return {
          sending: dict.sending ?? (lang === 'en' ? 'Sending …' : 'Wird gesendet …'),
          success: dict.success ?? (lang === 'en' ? 'Thanks for your message! I usually reply within 24 hours.' : 'Danke für deine Nachricht! Ich melde mich in der Regel innerhalb von 24 Stunden.'),
          error: dict.error ?? (lang === 'en' ? "That didn't work. Please email me directly." : 'Das hat leider nicht geklappt. Schreib mir bitte direkt per E-Mail.'),
        };
      };
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const strings = getStrings();
        const submitLabel = submitBtn.querySelector('span');
        const originalLabel = submitLabel?.textContent;
        submitBtn.disabled = true;
        if (submitLabel) submitLabel.textContent = strings.sending;
        statusEl.classList.add('hidden');
        try {
          const response = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { 'Accept': 'application/json' },
          });
          if (!response.ok) throw new Error('Formspree error');
          form.reset();
          statusEl.textContent = strings.success;
          statusEl.className = 'text-sm border-l-2 pl-4 py-1 border-paper text-paper';
        } catch (err) {
          statusEl.textContent = strings.error;
          statusEl.className = 'text-sm border-l-2 pl-4 py-1 border-red-400 text-red-200';
        } finally {
          submitBtn.disabled = false;
          if (submitLabel && originalLabel) submitLabel.textContent = originalLabel;
        }
      });
    }
  });
</script>
