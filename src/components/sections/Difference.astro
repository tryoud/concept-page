---
interface Props {
  lang?: string;
}
const { lang = 'de' } = Astro.props;
const isEn = lang === 'en';

const rows = [
  {
    key: 'design',
    de: { label: 'Design', bad: 'Template, das tausend andere auch nutzen', good: 'Auf dein Angebot und deine Zielgruppe zugeschnitten' },
    en: { label: 'Design', bad: 'A template a thousand others use too', good: 'Cut to fit your offer and your audience' },
  },
  {
    key: 'speed',
    de: { label: 'Performance', bad: 'Plugin-Ballast, langsame Ladezeiten', good: 'Statisch gebaut, weltweit per CDN ausgeliefert' },
    en: { label: 'Performance', bad: 'Plugin bloat, slow load times', good: 'Statically built, delivered worldwide via CDN' },
  },
  {
    key: 'content',
    de: { label: 'Bildsprache', bad: 'Stockfotos aus der Datenbank', good: 'Eigene Foto-, Video- und Drohnenaufnahmen' },
    en: { label: 'Imagery', bad: 'Stock photos from a database', good: 'Your own photo, video, and drone footage' },
  },
  {
    key: 'contact',
    de: { label: 'Zusammenarbeit', bad: 'Ticket-System und wechselnde Ansprechpartner', good: 'Direkt mit der Person, die auch umsetzt' },
    en: { label: 'Collaboration', bad: 'Ticket systems and rotating contacts', good: 'Straight to the person who builds it' },
  },
];

const stack = ['Astro', 'WordPress', 'TypeScript', 'Cloudflare', 'Figma', 'Premiere Pro', 'Lightroom'];
---

<section id="expertise" class="section w-full border-t rule">
  <div class="shell">
    <div class="max-w-2xl mb-12 md:mb-16 reveal-on-scroll">
      <span class="eyebrow mb-4" data-i18n="difference.eyebrow">{isEn ? 'The difference' : 'Der Unterschied'}</span>
      <h2 class="h-section">
        <span data-i18n="difference.headingPrefix">{isEn ? 'Page builder' : 'Baukasten'}</span> <span class="text-ink-3" data-i18n="difference.headingVs">{isEn ? 'vs.' : 'vs.'}</span> <span class="em" data-i18n="difference.headingAccent">{isEn ? 'custom-built.' : 'nach Maß.'}</span>
      </h2>
      <p class="mt-5 text-ink-2 leading-relaxed" data-i18n="difference.subline">
        {isEn ? 'A page builder gets you online. It rarely gets you inquiries. Here is where the two approaches actually diverge.' : 'Mit einem Baukasten bist du online. Anfragen bekommst du damit selten. Hier liegen die echten Unterschiede.'}
      </p>
    </div>

    <div class="reveal-on-scroll">
      <!-- Column headers (desktop) -->
      <div class="hidden md:grid grid-cols-[minmax(0,0.6fr)_minmax(0,1fr)_minmax(0,1fr)] gap-8 pb-3 border-b border-ink text-xs">
        <span></span>
        <span class="text-ink-3" data-i18n="difference.colBad">{isEn ? 'Page builder / template' : 'Baukasten / Template'}</span>
        <span class="text-ink font-medium" data-i18n="difference.colGood">{isEn ? 'tryoud' : 'tryoud'}</span>
      </div>

      {rows.map(r => (
        <div class="grid grid-cols-1 md:grid-cols-[minmax(0,0.6fr)_minmax(0,1fr)_minmax(0,1fr)] gap-2 md:gap-8 py-5 md:py-6 border-b rule">
          <span class="font-display text-xl text-ink" data-i18n={`difference.rows.${r.key}.label`}>{isEn ? r.en.label : r.de.label}</span>

          <span class="text-sm text-ink-3 md:pt-1">
            <span class="md:hidden block text-xs mb-0.5" data-i18n="difference.colBad">{isEn ? 'Page builder / template' : 'Baukasten / Template'}</span>
            <span data-i18n={`difference.rows.${r.key}.bad`}>{isEn ? r.en.bad : r.de.bad}</span>
          </span>

          <span class="text-sm text-ink mt-1 md:mt-0 md:pt-1">
            <span class="md:hidden block text-xs text-ink-3 mb-0.5" data-i18n="difference.colGood">tryoud</span>
            <span data-i18n={`difference.rows.${r.key}.good`}>{isEn ? r.en.good : r.de.good}</span>
          </span>
        </div>
      ))}
    </div>

    <p class="mt-8 text-sm text-ink-3 reveal-on-scroll">
      <span data-i18n="difference.stackLabel">{isEn ? 'Built with' : 'Gebaut mit'}</span>
      <span class="text-ink-2">{stack.join(', ')}</span>
    </p>
  </div>
</section>
