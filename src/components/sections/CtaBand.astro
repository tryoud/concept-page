---
interface Props {
  lang?: string;
}
const { lang = 'de' } = Astro.props;
const isEn = lang === 'en';
---

<section class="w-full bg-[#0b0c0e] relative z-40 pb-16 md:pb-20">
  <div class="shell">
    <div class="reveal-on-scroll relative overflow-hidden rounded-3xl border border-cyan-500/20 px-7 py-10 md:px-12 md:py-12">
      <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse 90% 130% at 15% 0%, rgba(34,211,238,0.14), transparent 60%), linear-gradient(180deg, rgba(255,255,255,0.04), rgba(255,255,255,0.01));"></div>

      <div class="relative flex flex-col lg:flex-row lg:items-center lg:justify-between gap-7">
        <div class="max-w-xl">
          <h2 class="text-2xl md:text-3xl text-white leading-tight" data-i18n="ctaBand.heading">
            {isEn ? 'Curious what this would look like for you?' : 'Neugierig, wie das für dich aussehen würde?'}
          </h2>
          <p class="mt-3 text-zinc-400 leading-relaxed" data-i18n="ctaBand.text">
            {isEn ? 'Tell me about your project in two sentences. You get an honest assessment — including when I am not the right fit.' : 'Erzähl mir in zwei Sätzen von deinem Projekt. Du bekommst eine ehrliche Einschätzung — auch dann, wenn ich nicht der Richtige bin.'}
          </p>
        </div>

        <div class="shrink-0 flex flex-col items-start lg:items-end gap-2.5">
          <a href="#contact" class="group btn btn-primary text-base w-full sm:w-auto">
            <span data-i18n="ctaBand.cta">{isEn ? 'Get an assessment' : 'Einschätzung anfragen'}</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
          </a>
          <span class="text-xs text-zinc-500" data-i18n="ctaBand.note">{isEn ? 'Free · no obligation · reply within 24 h' : 'Kostenlos · unverbindlich · Antwort in 24 h'}</span>
        </div>
      </div>
    </div>
  </div>
</section>
