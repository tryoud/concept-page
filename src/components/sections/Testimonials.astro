---
interface Props {
  lang?: string;
}
const { lang = 'de' } = Astro.props;
const isEn = lang === 'en';

interface Testimonial {
  quote: string;
  quoteEn?: string;
  name: string;
  role: string;
  roleEn?: string;
  /** Optional: /public path to a portrait or company logo */
  avatar?: string;
}

/* ------------------------------------------------------------------
   ADD YOUR REAL CLIENT QUOTES HERE.
   The whole section stays hidden while this array is empty, so no
   placeholder text can ever go live by accident. Two or three strong
   quotes beat six weak ones — ideally each one names a concrete result.

   Example shape:
   {
     quote: 'Nikolas hat unsere Alumni-Plattform in sechs Wochen neu aufgesetzt. Die Pflege macht jetzt das Team selbst.',
     quoteEn: 'Nikolas rebuilt our alumni platform in six weeks. The team maintains it themselves now.',
     name: 'Vorname Nachname',
     role: 'Position, Firma',
     roleEn: 'Position, Company',
     avatar: '/testimonials/person.jpg',
   },
   ------------------------------------------------------------------ */
const testimonials: Testimonial[] = [];
---

{testimonials.length > 0 && (
  <section id="testimonials" class="section w-full bg-[#050506] relative z-40 border-t border-white/10">
    <div class="shell">
      <div class="max-w-2xl mb-12 reveal-on-scroll">
        <span class="eyebrow mb-3" data-i18n="testimonials.eyebrow">{isEn ? 'Client feedback' : 'Kundenstimmen'}</span>
        <h2 class="text-3xl md:text-5xl text-white leading-[1.1]" data-i18n="testimonials.heading">
          {isEn ? 'What clients say.' : 'Was Kunden sagen.'}
        </h2>
      </div>

      <div class={`grid gap-5 ${testimonials.length === 1 ? 'max-w-2xl' : testimonials.length === 2 ? 'md:grid-cols-2' : 'md:grid-cols-2 lg:grid-cols-3'}`}>
        {testimonials.map((t, i) => (
          <figure class="card reveal-on-scroll p-7 flex flex-col" style={`--reveal-delay: ${i * 90}ms`}>
            <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="currentColor" class="text-cyan-500/25 mb-5" aria-hidden="true"><path d="M9.5 4C6 4 3 7 3 10.5S6 17 9.5 17c.3 0 .6 0 .9-.1C9.6 19 7.8 20.4 5.5 21l.8 1.9C10.7 21.6 13 17.7 13 12.5 13 7.8 11.6 4 9.5 4Zm11 0C17 4 14 7 14 10.5s3 6.5 6.5 6.5c.3 0 .6 0 .9-.1-.8 2.1-2.6 3.5-4.9 4.1l.8 1.9c4.4-1.3 6.7-5.2 6.7-10.4C24 7.8 22.6 4 20.5 4Z"/></svg>

            <blockquote class="text-zinc-200 leading-relaxed flex-grow" data-i18n={`testimonials.items.${i}.quote`}>
              {isEn && t.quoteEn ? t.quoteEn : t.quote}
            </blockquote>

            <figcaption class="mt-6 pt-5 border-t border-white/8 flex items-center gap-3">
              {t.avatar && (
                <img src={t.avatar} alt="" aria-hidden="true" class="w-10 h-10 rounded-full object-cover border border-white/10" loading="lazy" decoding="async" />
              )}
              <div>
                <p class="text-sm font-semibold text-white">{t.name}</p>
                <p class="text-xs text-zinc-500" data-i18n={`testimonials.items.${i}.role`}>
                  {isEn && t.roleEn ? t.roleEn : t.role}
                </p>
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
