---
interface Props {
  lang?: string;
}
const { lang = 'de' } = Astro.props;
const isEn = lang === 'en';

interface Testimonial {
  quote: string;
  quoteEn?: string;
  name: string;
  role: string;
  roleEn?: string;
  /** Optional: /public path to a portrait or company logo */
  avatar?: string;
}

/* ------------------------------------------------------------------
   ADD YOUR REAL CLIENT QUOTES HERE.
   The whole section stays hidden while this array is empty, so no
   placeholder text can ever go live by accident. Two or three strong
   quotes beat six weak ones - ideally each one names a concrete result.

   Example shape:
   {
     quote: 'Nikolas hat unsere Alumni-Plattform in sechs Wochen neu aufgesetzt. Die Pflege macht jetzt das Team selbst.',
     quoteEn: 'Nikolas rebuilt our alumni platform in six weeks. The team maintains it themselves now.',
     name: 'Vorname Nachname',
     role: 'Position, Firma',
     roleEn: 'Position, Company',
     avatar: '/testimonials/person.jpg',
   },
   ------------------------------------------------------------------ */
const testimonials: Testimonial[] = [];
---

{testimonials.length > 0 && (
  <section id="testimonials" class="section w-full border-t rule">
    <div class="shell">
      <div class="max-w-2xl mb-12 md:mb-16 reveal-on-scroll">
        <span class="eyebrow mb-4" data-i18n="testimonials.eyebrow">{isEn ? 'Client feedback' : 'Kundenstimmen'}</span>
        <h2 class="h-section" data-i18n="testimonials.heading">
          {isEn ? 'What clients say.' : 'Was Kunden sagen.'}
        </h2>
      </div>

      <div class={`grid gap-10 ${testimonials.length === 1 ? 'max-w-2xl' : testimonials.length === 2 ? 'md:grid-cols-2' : 'md:grid-cols-2 lg:grid-cols-3'}`}>
        {testimonials.map((t, i) => (
          <figure class="reveal-on-scroll border-t rule pt-6 flex flex-col">
            <blockquote class="font-display text-2xl leading-snug text-ink flex-grow" data-i18n={`testimonials.items.${i}.quote`}>
              {isEn && t.quoteEn ? t.quoteEn : t.quote}
            </blockquote>

            <figcaption class="mt-6 flex items-center gap-3">
              {t.avatar && (
                <img src={t.avatar} alt="" aria-hidden="true" class="w-10 h-10 rounded-full object-cover border rule" loading="lazy" decoding="async" />
              )}
              <div>
                <p class="text-sm font-medium text-ink">{t.name}</p>
                <p class="text-xs text-ink-3" data-i18n={`testimonials.items.${i}.role`}>
                  {isEn && t.roleEn ? t.roleEn : t.role}
                </p>
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
