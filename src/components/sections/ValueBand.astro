---
interface Props {
  lang?: string;
}
const { lang = 'de' } = Astro.props;
const isEn = lang === 'en';

const points = [
  {
    key: 'one',
    de: { title: 'Ein Ansprechpartner', text: 'Strategie, Design, Code und Content laufen bei einer Person zusammen. Keine Übergaben zwischen Agentur, Fotograf und Entwickler.' },
    en: { title: 'One point of contact', text: 'Strategy, design, code, and content all sit with one person. No hand-offs between agency, photographer, and developer.' },
    icon: 'user',
  },
  {
    key: 'custom',
    de: { title: 'Kein Baukasten', text: 'Jede Seite wird auf dein Angebot zugeschnitten und von Hand entwickelt — statt ein Template zurechtzubiegen.' },
    en: { title: 'No page builder', text: 'Every page is cut to fit your offer and hand-coded — instead of bending a template into shape.' },
    icon: 'code',
  },
  {
    key: 'content',
    de: { title: 'Eigener Content', text: 'Foto-, Video- und Drohnenaufnahmen von deinem Unternehmen. Kein Stockmaterial, das auch die Konkurrenz nutzt.' },
    en: { title: 'Your own content', text: 'Photo, video, and drone footage of your actual company. No stock material your competitors use too.' },
    icon: 'camera',
  },
];
---

<section class="section-tight w-full bg-[#050506] relative z-40 border-y border-white/10">
  <div class="shell">
    <div class="flex flex-col gap-10 lg:gap-12">
      <div class="reveal-on-scroll flex flex-col lg:flex-row lg:items-end lg:justify-between gap-5 lg:gap-10">
        <div class="max-w-xl">
          <span class="eyebrow mb-3" data-i18n="journey.eyebrow">{isEn ? 'Why tryoud' : 'Warum tryoud'}</span>
          <h2 class="text-3xl md:text-4xl lg:text-[2.75rem] text-white leading-[1.1]" data-i18n="journey.headline">
            {isEn ? 'Everything from one source.' : 'Alles aus einer Hand.'}
          </h2>
        </div>
        <p class="text-zinc-400 leading-relaxed max-w-md lg:text-right" data-i18n="journey.sub">
          {isEn ? 'One partner from the first idea to launch — no hand-offs, no friction, no finger-pointing when something breaks.' : 'Ein Partner von der ersten Idee bis zum Launch — keine Übergaben, keine Reibungsverluste, keine Schuldzuweisungen, wenn etwas hakt.'}
        </p>
      </div>

      <ul class="grid grid-cols-1 sm:grid-cols-3 gap-7 lg:gap-8">
        {points.map((p, i) => (
          <li class="reveal-on-scroll" style={`--reveal-delay: ${i * 80}ms`}>
            <div class="w-10 h-10 rounded-xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400 mb-4">
              {p.icon === 'user' && <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>}
              {p.icon === 'code' && <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>}
              {p.icon === 'camera' && <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3Z"/><circle cx="12" cy="13" r="3"/></svg>}
            </div>
            <h3 class="text-base font-semibold text-white mb-2" data-i18n={`journey.points.${p.key}.title`}>{isEn ? p.en.title : p.de.title}</h3>
            <p class="text-sm text-zinc-400 leading-relaxed" data-i18n={`journey.points.${p.key}.text`}>{isEn ? p.en.text : p.de.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
