---
interface Props {
  lang?: string;
}
const { lang = 'de' } = Astro.props;
const isEn = lang === 'en';
const year = new Date().getFullYear();

const navLinks = [
  { href: '/#services', key: 'nav.services', de: 'Leistungen', en: 'Services' },
  { href: '/#work', key: 'nav.work', de: 'Referenzen', en: 'Work' },
  { href: '/#process', key: 'nav.process', de: 'Ablauf', en: 'Process' },
  { href: '/#faq', key: 'nav.faq', de: 'FAQ', en: 'FAQ' },
];

const socials = [
  { label: 'Instagram', href: 'https://www.instagram.com/nikolasmaerker' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/nikolasmaerker/' },
  { label: 'GitHub', href: 'https://github.com/tryoud' },
];
---

<footer class="border-t border-white/10 bg-[#050506]">
  <div class="shell py-12 md:py-14">
    <div class="grid grid-cols-2 md:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)_minmax(0,1fr)] gap-8 md:gap-10">
      <div class="col-span-2 md:col-span-1 max-w-sm">
        <a href="/" class="flex items-center gap-2.5 w-fit group">
          <img src="/favicon.svg" alt="" aria-hidden="true" class="w-8 h-8 rounded-lg" />
          <span class="text-lg font-semibold tracking-tight text-white">tryoud</span>
        </a>
        <p class="mt-4 text-sm text-zinc-500 leading-relaxed" data-i18n="footer.blurb">
          {isEn
            ? 'Custom websites, photo, video, and drone content for mid-sized companies — designed, built, and shot by one person.'
            : 'Maßgeschneiderte Websites, Foto-, Video- und Drohnencontent für den Mittelstand — konzipiert, gebaut und gedreht von einer Person.'}
        </p>
      </div>

      <nav aria-label={isEn ? 'Footer navigation' : 'Footer-Navigation'}>
        <h2 class="text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-zinc-600 mb-4" data-i18n="footer.navHeading">
          {isEn ? 'Navigation' : 'Navigation'}
        </h2>
        <ul class="space-y-2.5">
          {navLinks.map(l => (
            <li>
              <a href={l.href} class="text-sm text-zinc-400 hover:text-white transition-colors" data-i18n={l.key}>{isEn ? l.en : l.de}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div>
        <h2 class="text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-zinc-600 mb-4" data-i18n="footer.contactHeading">
          {isEn ? 'Contact' : 'Kontakt'}
        </h2>
        <ul class="space-y-2.5">
          <li>
            <a href="mailto:nikolas.maerker@gmail.com" class="text-sm text-zinc-400 hover:text-white transition-colors break-all">nikolas.maerker@gmail.com</a>
          </li>
          {socials.map(sc => (
            <li>
              <a href={sc.href} target="_blank" rel="noopener" class="text-sm text-zinc-400 hover:text-white transition-colors">{sc.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-white/8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-sm text-zinc-600">
      <p>© {year} Nikolas Maerker. <span data-i18n="footer.rights">{isEn ? 'All rights reserved.' : 'Alle Rechte vorbehalten.'}</span></p>
      <div class="flex gap-6">
        <a href="/imprint" class="hover:text-zinc-300 transition-colors" data-i18n="footer.imprint">{isEn ? 'Imprint' : 'Impressum'}</a>
        <a href="/privacy" class="hover:text-zinc-300 transition-colors" data-i18n="footer.privacy">{isEn ? 'Privacy' : 'Datenschutz'}</a>
      </div>
    </div>
  </div>
</footer>
