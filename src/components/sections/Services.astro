---
interface Props {
  lang?: string;
}
const { lang = 'de' } = Astro.props;
const isEn = lang === 'en';

/* Starting rates. These numbers also appear in the FAQ answer ("Was kostet
   eine Website?") and in the Offer JSON-LD in Layout.astro - keep all three
   in sync when they change. */
const services = [
  {
    key: 'web',
    /* Two entry points into the same service: a single landing page, or a
       full multi-page site. Content/drone stay single-tier. */
    from: [
      { de: { label: 'Landing Page', price: '1.490 €' }, en: { label: 'Landing page', price: '€1,490' } },
      { de: { label: 'Komplettauftritt', price: '3.500 €' }, en: { label: 'Complete website', price: '€3,500' } },
    ],
    de: {
      title: 'Websites & Landing Pages',
      text: 'Performante Websites, die deine Leistung verständlich machen und auf Anfragen ausgerichtet sind.',
      bullets: ['Positionierung & UX-Strategie', 'SEO & Performance-Optimierung', 'Astro, WordPress, Cloudflare'],
    },
    en: {
      title: 'Websites & Landing Pages',
      text: 'High-performance websites that explain your offer clearly and turn visitors into inquiries.',
      bullets: ['Positioning & UX strategy', 'SEO & performance optimization', 'Astro, WordPress, Cloudflare'],
    },
  },
  {
    key: 'content',
    from: [{ de: { label: null, price: '850 €' }, en: { label: null, price: '€850' } }],
    de: {
      title: 'Foto & Video',
      text: 'Foto- und Videocontent, der deine Marke hochwertig zeigt - für Website, Social Media und Kampagnen.',
      bullets: ['Event-, Portrait- & Redaktionsfotografie', 'Videoproduktion & Videoschnitt', 'Einheitlicher Look für alle Kanäle'],
    },
    en: {
      title: 'Photo & Video',
      text: 'Photo and video content that presents your brand with a premium look - for websites, social media, and campaigns.',
      bullets: ['Event, portrait & editorial photography', 'Video production & editing', 'Consistent look across every channel'],
    },
  },
  {
    key: 'drone',
    from: [{ de: { label: null, price: '590 €' }, en: { label: null, price: '€590' } }],
    de: {
      title: 'Drohne & Aerial',
      text: 'Lizenzierte Drohnenaufnahmen für Immobilien, Events und Markencontent. Filmische Shots.',
      bullets: ['Lizenzierte Luftaufnahmen', 'Immobilien, Events & Unternehmen', 'Ruhige, filmische Shots'],
    },
    en: {
      title: 'Drone & Aerial',
      text: 'Licensed drone footage for real estate, events, and brand content. Cinematic shots.',
      bullets: ['Licensed aerial footage', 'Real estate, events & companies', 'Smooth, cinematic shots'],
    },
  },
];
---

<section id="services" class="section w-full bg-paper-2 border-t rule">
  <div class="shell">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between mb-12 md:mb-16 gap-6">
      <div class="reveal-on-scroll max-w-xl">
        <span class="eyebrow mb-4" data-i18n="services.eyebrow">{isEn ? 'Services' : 'Leistungen'}</span>
        <h2 class="h-section">
          <span data-i18n="services.headingPrefix">{isEn ? 'What I' : 'Was ich'}</span> <span class="em" data-i18n="services.headingAccent">{isEn ? 'do.' : 'mache.'}</span>
        </h2>
      </div>
      <p class="text-ink-2 max-w-sm reveal-on-scroll leading-relaxed" data-i18n="services.subline">
        {isEn ? 'Strategy, design, code, and content from one source - without the friction of juggling three different vendors.' : 'Strategie, Design, Code und Content aus einer Hand - ohne Reibungsverluste zwischen drei verschiedenen Dienstleistern.'}
      </p>
    </div>

    <!-- Rows, not cards: each service reads as an entry in a price list -->
    <div class="border-t rule">
      {services.map((s) => (
        <article class="reveal-on-scroll grid grid-cols-1 md:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)_minmax(0,0.6fr)] gap-6 md:gap-10 py-9 md:py-11 border-b rule">
          <div>
            <h3 class="h-sub md:text-[1.9rem] mb-3" data-i18n={`services.${s.key}.title`}>{isEn ? s.en.title : s.de.title}</h3>
            <p class="text-ink-2 leading-relaxed max-w-md" data-i18n={`services.${s.key}.text`}>{isEn ? s.en.text : s.de.text}</p>
          </div>

          <ul class="space-y-2 text-sm text-ink-2 md:pt-2">
            {(isEn ? s.en.bullets : s.de.bullets).map((b, bi) => (
              <li class="flex items-start gap-3">
                <span class="text-ink-3 shrink-0" aria-hidden="true">&mdash;</span>
                <span data-i18n={`services.${s.key}.bullet${bi + 1}`}>{b}</span>
              </li>
            ))}
          </ul>

          <div class="md:text-right md:pt-1">
            <span class="block text-xs text-ink-3 mb-1" data-i18n="services.fromLabel">{isEn ? 'Projects from' : 'Projekte ab'}</span>
            <div class={s.from.length > 1 ? 'space-y-2.5' : ''}>
              {s.from.map((tier, ti) => (
                <div>
                  {tier.de.label && (
                    <span class="block text-xs text-ink-3" data-i18n={`services.${s.key}.tier${ti}Label`}>{isEn ? tier.en.label : tier.de.label}</span>
                  )}
                  <span class={`block font-display text-ink ${s.from.length > 1 ? 'text-xl' : 'text-2xl'}`} data-i18n={`services.${s.key}.tier${ti}Price`}>{isEn ? tier.en.price : tier.de.price}</span>
                </div>
              ))}
            </div>
            <a
              href="#contact"
              data-service={s.key}
              class="service-cta link inline-block mt-4 text-sm text-ink"
            >
              <span data-i18n="services.cta">{isEn ? 'Enquire' : 'Anfragen'}</span>
            </a>
          </div>
        </article>
      ))}
    </div>

    <p class="mt-6 text-sm text-ink-3 max-w-2xl reveal-on-scroll" data-i18n="services.priceNote">
      {isEn ? 'Final price depends on scope - you get a fixed quote before anything starts. No hourly surprises.' : 'Der Endpreis hängt vom Umfang ab - du bekommst vor dem Start ein Festpreis-Angebot. Keine Überraschungen nach Stundenzettel.'}
    </p>
  </div>
</section>

<script>
  // Clicking "Anfragen" on a service row preselects that service in the contact form
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLAnchorElement>('.service-cta').forEach(link => {
      link.addEventListener('click', () => {
        const select = document.getElementById('contact-service') as HTMLSelectElement | null;
        if (select && link.dataset.service) select.value = link.dataset.service;
      });
    });
  });
</script>
