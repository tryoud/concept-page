---
interface Props {
  lang?: string;
}
const { lang = 'de' } = Astro.props;
const isEn = lang === 'en';

const steps = [
  {
    de: { title: 'Erstgespräch', text: 'Wir klären in 30 Minuten, was du brauchst, was es bringen soll und ob ich der Richtige dafür bin.' },
    en: { title: 'First call', text: 'In 30 minutes we clarify what you need, what it should achieve, and whether I am the right fit.' },
    badgeDe: 'Kostenlos',
    badgeEn: 'Free',
  },
  {
    de: { title: 'Konzept & Angebot', text: 'Positionierung, Struktur und technischer Ansatz — inklusive Festpreis-Angebot, bevor irgendetwas beginnt.' },
    en: { title: 'Concept & quote', text: 'Positioning, structure, and technical approach — including a fixed-price quote before anything starts.' },
    badgeDe: null,
    badgeEn: null,
  },
  {
    de: { title: 'Umsetzung', text: 'Design, Entwicklung und Content-Produktion. Du siehst Zwischenstände und gibst Feedback, bevor es final wird.' },
    en: { title: 'Build', text: 'Design, development, and content production. You see progress and give feedback before anything is final.' },
    badgeDe: null,
    badgeEn: null,
  },
  {
    de: { title: 'Launch & Betreuung', text: 'Go-Live, Übergabe und auf Wunsch laufende Pflege und Optimierung.' },
    en: { title: 'Launch & support', text: 'Go-live, hand-over, and ongoing maintenance and optimization if you want it.' },
    badgeDe: null,
    badgeEn: null,
  },
];
---

<section id="process" class="section w-full bg-[#0b0c0e] relative z-40 border-t border-white/10">
  <div class="shell">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12 reveal-on-scroll">
      <div class="max-w-xl">
        <span class="eyebrow mb-3" data-i18n="process.eyebrow">{isEn ? 'Process' : 'Ablauf'}</span>
        <h2 class="text-3xl md:text-5xl text-white leading-[1.1]">
          <span data-i18n="process.headingPrefix">{isEn ? 'How' : 'So'}</span> <span class="text-cyan-400" data-i18n="process.headingAccent">{isEn ? 'I work.' : 'arbeite ich.'}</span>
        </h2>
      </div>
      <p class="text-zinc-400 max-w-sm leading-relaxed" data-i18n="process.subline">
        {isEn ? 'Four clear steps. You always know what happens next and what it costs.' : 'Vier klare Schritte. Du weißt jederzeit, was als Nächstes passiert und was es kostet.'}
      </p>
    </div>

    <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 relative">
      <!-- Connecting rail (desktop only) -->
      <div class="hidden lg:block absolute top-[1.4rem] left-[6%] right-[6%] h-px bg-gradient-to-r from-cyan-500/40 via-white/10 to-transparent" aria-hidden="true"></div>

      {steps.map((step, idx) => (
        <li class="relative reveal-on-scroll" style={`--reveal-delay: ${idx * 90}ms`}>
          <div class="flex items-center gap-3 mb-5">
            <span class="relative z-10 w-11 h-11 shrink-0 rounded-full bg-[#0b0c0e] border border-cyan-500/30 text-cyan-400 flex items-center justify-center font-semibold text-sm">
              {String(idx + 1).padStart(2, '0')}
            </span>
            {(isEn ? step.badgeEn : step.badgeDe) && (
              <span class="text-[0.65rem] font-semibold uppercase tracking-[0.12em] px-2 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/25 text-cyan-300" data-i18n={`process.steps.${idx}.badge`}>
                {isEn ? step.badgeEn : step.badgeDe}
              </span>
            )}
          </div>
          <h3 class="text-lg font-semibold text-white mb-2" data-i18n={`process.steps.${idx}.title`}>{isEn ? step.en.title : step.de.title}</h3>
          <p class="text-sm text-zinc-400 leading-relaxed" data-i18n={`process.steps.${idx}.text`}>{isEn ? step.en.text : step.de.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
