---
interface Props {
  lang?: string;
}
const { lang = 'de' } = Astro.props;
const isEn = lang === 'en';

const steps = [
  {
    de: { title: 'Erstgespräch', text: 'Wir klären in 30 Minuten, was du brauchst, was es bringen soll und ob ich der Richtige dafür bin.' },
    en: { title: 'First call', text: 'In 30 minutes we clarify what you need, what it should achieve, and whether I am the right fit.' },
    badgeDe: 'Kostenlos',
    badgeEn: 'Free',
  },
  {
    de: { title: 'Konzept & Angebot', text: 'Positionierung, Struktur und technischer Ansatz - inklusive Festpreis-Angebot, bevor irgendetwas beginnt.' },
    en: { title: 'Concept & quote', text: 'Positioning, structure, and technical approach - including a fixed-price quote before anything starts.' },
    badgeDe: null,
    badgeEn: null,
  },
  {
    de: { title: 'Umsetzung', text: 'Design, Entwicklung und Content-Produktion. Du siehst Zwischenstände und gibst Feedback, bevor es final wird.' },
    en: { title: 'Build', text: 'Design, development, and content production. You see progress and give feedback before anything is final.' },
    badgeDe: null,
    badgeEn: null,
  },
  {
    de: { title: 'Launch & Betreuung', text: 'Go-Live, Übergabe und auf Wunsch laufende Pflege und Optimierung.' },
    en: { title: 'Launch & support', text: 'Go-live, hand-over, and ongoing maintenance and optimization if you want it.' },
    badgeDe: null,
    badgeEn: null,
  },
];
---

<section id="process" class="section w-full border-t rule">
  <div class="shell">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12 md:mb-16 reveal-on-scroll">
      <div class="max-w-xl">
        <span class="eyebrow mb-4" data-i18n="process.eyebrow">{isEn ? 'Process' : 'Ablauf'}</span>
        <h2 class="h-section">
          <span data-i18n="process.headingPrefix">{isEn ? 'How' : 'So'}</span> <span class="em" data-i18n="process.headingAccent">{isEn ? 'I work.' : 'arbeite ich.'}</span>
        </h2>
      </div>
      <p class="text-ink-2 max-w-sm leading-relaxed" data-i18n="process.subline">
        {isEn ? 'Four clear steps. You always know what happens next and what it costs.' : 'Vier klare Schritte. Du weißt jederzeit, was als Nächstes passiert und was es kostet.'}
      </p>
    </div>

    <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-10">
      {steps.map((step, idx) => (
        <li class="reveal-on-scroll border-t border-ink pt-5">
          <div class="flex items-baseline justify-between gap-3 mb-6">
            <span class="font-display text-3xl text-ink tabular-nums">{idx + 1}</span>
            {(isEn ? step.badgeEn : step.badgeDe) && (
              <span class="text-xs text-accent" data-i18n={`process.steps.${idx}.badge`}>
                {isEn ? step.badgeEn : step.badgeDe}
              </span>
            )}
          </div>
          <h3 class="h-sub mb-3" data-i18n={`process.steps.${idx}.title`}>{isEn ? step.en.title : step.de.title}</h3>
          <p class="text-sm text-ink-2 leading-relaxed" data-i18n={`process.steps.${idx}.text`}>{isEn ? step.en.text : step.de.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
