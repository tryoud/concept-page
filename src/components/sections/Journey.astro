---
interface Props {
  lang?: string;
}
const { lang = 'de' } = Astro.props;
const isEn = lang === 'en';
---

<section class="relative w-full py-32 md:py-48 bg-black overflow-hidden border-y border-white/5" id="apple-journey">
  <!-- Static accent glow, no filters or animation -->
  <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse 60% 70% at 50% 100%, rgba(34,211,238,0.08), transparent 65%);"></div>

  <div class="relative max-w-5xl mx-auto px-6 md:px-16 text-center">
    <h2 class="text-5xl sm:text-6xl md:text-8xl font-black text-white tracking-tighter leading-[1.05] reveal-on-scroll" data-i18n="journey.headline">{isEn ? 'Everything from' : 'Alles aus'}<br/>{isEn ? 'one source.' : 'einer Hand.'}</h2>
    <p class="mt-8 text-lg md:text-2xl text-zinc-400 font-light max-w-2xl mx-auto reveal-on-scroll" data-i18n="journey.sub">
      {isEn ? 'Strategy, design, code, and content — one partner from the first idea to launch. No hand-offs, no friction.' : 'Strategie, Design, Code und Content — ein Partner von der ersten Idee bis zum Launch. Keine Übergaben, keine Reibungsverluste.'}
    </p>
    <div class="mt-10 h-1 w-24 mx-auto rounded-full bg-gradient-to-r from-cyan-400 to-violet-500 reveal-on-scroll"></div>
  </div>
</section>
