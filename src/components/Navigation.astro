---
interface Props {
  lang?: string;
}

const { lang = 'de' } = Astro.props;
const isEn = lang === 'en';

/* A bare "#services" goes nowhere from /imprint or /privacy, so those pages need
   the "/" prefix; the homepage keeps the bare hash to stay a same-page scroll. */
const isHome = Astro.url.pathname === '/';
const to = (hash: string) => (isHome ? hash : `/${hash}`);

const links = [
  { href: to('#services'), key: 'nav.services', de: 'Leistungen', en: 'Services' },
  { href: to('#work'), key: 'nav.work', de: 'Referenzen', en: 'Work' },
  { href: to('#process'), key: 'nav.process', de: 'Ablauf', en: 'Process' },
  { href: to('#faq'), key: 'nav.faq', de: 'FAQ', en: 'FAQ' },
];
---

<nav id="site-nav" class="fixed top-0 w-full z-50 transition-colors duration-300 border-b border-transparent">
  <div class="shell flex items-center justify-between py-4">
    <a href="/" class="font-display text-2xl leading-none text-ink relative z-50">tryoud</a>

    <!-- Desktop Nav -->
    <div class="hidden md:flex items-center gap-7">
      {links.map(l => (
        <a
          href={l.href}
          data-navlink={l.href.split("#")[1]}
          class="nav-link text-sm"
          data-i18n={l.key}
        >{isEn ? l.en : l.de}</a>
      ))}
    </div>

    <div class="hidden md:flex items-center gap-6">
      <div class="flex items-center gap-2 text-xs font-medium" aria-label={isEn ? 'Language' : 'Sprachauswahl'}>
        <button type="button" class="language-switcher" data-lang-switch="de" aria-label="Deutsch" aria-pressed={!isEn}>DE</button>
        <span class="text-ink-3" aria-hidden="true">/</span>
        <button type="button" class="language-switcher" data-lang-switch="en" aria-label="English" aria-pressed={isEn}>EN</button>
      </div>
      <a href={to("#contact")} class="btn btn-primary text-sm !py-2.5 !px-4" data-i18n="nav.contact">{isEn ? 'Start a project' : 'Projekt anfragen'}</a>
    </div>

    <!-- Mobile Menu Button -->
    <button id="mobile-menu-btn" class="md:hidden p-2 -mr-2 text-ink relative z-50" aria-label={isEn ? 'Open menu' : 'Menü öffnen'} aria-expanded="false" aria-controls="mobile-menu">
      <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><line x1="3" x2="21" y1="9" y2="9"/><line x1="3" x2="21" y1="15" y2="15"/></svg>
      <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" class="hidden"><line x1="6" x2="18" y1="6" y2="18"/><line x1="6" x2="18" y1="18" y2="6"/></svg>
    </button>
  </div>
</nav>

<!-- Mobile Menu -->
<div id="mobile-menu" class="fixed inset-0 bg-paper z-40 hidden flex-col justify-center gap-1 px-6 pt-24 pb-12 overflow-y-auto overscroll-contain">
  {links.map(l => (
    <a href={l.href} class="mobile-link font-display text-4xl text-ink py-3 border-b rule" data-i18n={l.key}>{isEn ? l.en : l.de}</a>
  ))}
  <a href={to("#contact")} class="mobile-link btn btn-primary mt-8 w-full py-4 text-base" data-i18n="nav.contact">{isEn ? 'Start a project' : 'Projekt anfragen'}</a>
  <div class="mt-8 flex items-center gap-3 text-sm font-medium" aria-label={isEn ? 'Language' : 'Sprachauswahl'}>
    <button type="button" class="language-switcher" data-lang-switch="de" aria-label="Deutsch" aria-pressed={!isEn}>DE</button>
    <span class="text-ink-3" aria-hidden="true">/</span>
    <button type="button" class="language-switcher" data-lang-switch="en" aria-label="English" aria-pressed={isEn}>EN</button>
  </div>
</div>

<!-- Sticky mobile CTA: the contact form sits far down, so mobile needs a permanent way in -->
<a
  id="sticky-cta"
  href={to("#contact")}
  class="md:hidden fixed bottom-4 inset-x-4 z-40 btn btn-primary py-3.5 text-sm translate-y-24 opacity-0 transition-all duration-300 shadow-[0_8px_24px_-8px_rgba(22,21,15,0.45)]"
  data-i18n="nav.contact"
>{isEn ? 'Start a project' : 'Projekt anfragen'}</a>

<script>
  document.addEventListener('astro:page-load', () => {
    const nav = document.getElementById('site-nav');
    const stickyCta = document.getElementById('sticky-cta');
    const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav-link'));

    // --- Nav background + sticky CTA ---
    const onScroll = () => {
      const y = window.scrollY;

      if (nav) {
        const solid = y > 24;
        nav.classList.toggle('bg-paper/90', solid);
        nav.classList.toggle('backdrop-blur-md', solid);
        nav.classList.toggle('border-line', solid);
        nav.classList.toggle('border-transparent', !solid);
      }
      if (stickyCta) {
        // Show once the hero is behind us, hide again over the contact form itself
        const contact = document.getElementById('contact');
        const contactTop = contact ? contact.getBoundingClientRect().top + y : Infinity;
        const show = y > window.innerHeight * 0.9 && y < contactTop - window.innerHeight * 0.5;
        stickyCta.classList.toggle('translate-y-24', !show);
        stickyCta.classList.toggle('opacity-0', !show);
        stickyCta.classList.toggle('pointer-events-none', !show);
      }
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    // --- Active section highlight ---
    const sections = navLinks
      .map(link => document.getElementById(link.dataset.navlink ?? ''))
      .filter((el): el is HTMLElement => Boolean(el));

    if (sections.length) {
      const setActive = (id: string) => {
        navLinks.forEach(link => {
          link.classList.toggle('is-active', link.dataset.navlink === id);
        });
      };
      const visibility = new Map<string, number>();
      const observer = new IntersectionObserver(
        entries => {
          entries.forEach(e => visibility.set(e.target.id, e.isIntersecting ? e.intersectionRatio : 0));
          let best = '';
          let bestRatio = 0;
          visibility.forEach((ratio, id) => {
            if (ratio > bestRatio) {
              bestRatio = ratio;
              best = id;
            }
          });
          if (best) setActive(best);
        },
        { rootMargin: '-15% 0px -55% 0px', threshold: [0, 0.25, 0.5, 0.75, 1] },
      );
      sections.forEach(s => observer.observe(s));
    }

    // --- Mobile menu ---
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('icon-open');
    const iconClose = document.getElementById('icon-close');

    if (mobileMenuBtn && mobileMenu) {
      const setMenu = (open: boolean) => {
        mobileMenu.classList.toggle('hidden', !open);
        mobileMenu.classList.toggle('flex', open);
        iconOpen?.classList.toggle('hidden', open);
        iconClose?.classList.toggle('hidden', !open);
        mobileMenuBtn.setAttribute('aria-expanded', String(open));
        document.body.style.overflow = open ? 'hidden' : '';
      };

      mobileMenuBtn.addEventListener('click', () => {
        setMenu(mobileMenu.classList.contains('hidden'));
      });
      document.querySelectorAll('.mobile-link').forEach(link => {
        link.addEventListener('click', () => setMenu(false));
      });
      document.addEventListener('keydown', e => {
        if (e.key === 'Escape' && !mobileMenu.classList.contains('hidden')) setMenu(false);
      });
    }
  });
</script>
